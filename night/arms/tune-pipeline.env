# Serving model and settings (compose.yaml) plus pipeline-windows=2: overlapped decode windows across the stages. o2606063-cyber/p100-strata-opt got +23-26% on code with --pipeline-windows 4 on two cards (engine 0.1.54); this engine (0.1.47) names 1 and 2.
# Speed runs only: the question is tok/s against tune-base, run in the same session.
ARM=tune-pipeline
FAMILY=qwen
MODEL=IQ3_S
GPUS=0,1,2
CONTEXT=256k
STRATA_SET="resident-experts kv-resident=32768 layer-split=12,34 conversation-cache-mib=8192 trim-stage-weights STRATA_GU_F16=2 STRATA_SM60_D20_SUB=1 STRATA_DOWN_F16=1 STRATA_B6_F16=1 STRATA_ROUTE_TAIL_SKIP=0 pipeline-windows=2"
STEPS="easy hard"
