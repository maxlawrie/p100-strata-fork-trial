# Megla123/qwen3.8-flash-next-2x-p100 built with its own build.sh on CUDA 12.9 for sm_60, plus what its setup.sh
# and server need at run time. Build context: the repository root.
FROM nvidia/cuda:12.9.1-devel-ubuntu24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential ca-certificates python3 binutils \
    && rm -rf /var/lib/apt/lists/*
COPY . /opt/fnx2
WORKDIR /opt/fnx2
RUN JOBS=8 bash build.sh

FROM nvidia/cuda:12.9.1-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates python3 python3-pip python3-venv curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/fnx2 /opt/fnx2
WORKDIR /opt/fnx2
ENTRYPOINT ["/bin/bash"]
