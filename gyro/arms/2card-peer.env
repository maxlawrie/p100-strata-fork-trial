# Arm 2: Gyro-S on the two PCIe 3.0 x8 cards in peer mode, the video's two-card settings (64K context).
# Same cards as the IQ3_S peer-mode run in results/followup/speed-peer-mode.txt, which hit 80 C on the primary.
ARM=2card-peer
GPUS=1,2
CONTEXT=64k
STRATA_SET="kv-resident=32768 vram-reserve-later-mib=1103 peer-device=1 peer-reserve-mib=2000 STRATA_GU_F16=2 STRATA_SM60_D20_SUB=1 STRATA_DOWN_F16=1 STRATA_B6_F16=1 STRATA_ROUTE_TAIL_SKIP=0"
