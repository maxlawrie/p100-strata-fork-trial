# Serving model and settings with layer-split=12,36: layers moved from GPU 2 (middle card, which also runs the
# head and the draft work) to GPU 1 (top card), for the duct with the stronger desk fan. Sustained run first, from cool.
ARM=split-12-36
FAMILY=qwen
MODEL=IQ3_S
GPUS=0,1,2
CONTEXT=256k
STRATA_SET="resident-experts kv-resident=32768 layer-split=12,36 conversation-cache-mib=8192 trim-stage-weights STRATA_GU_F16=2 STRATA_SM60_D20_SUB=1 STRATA_DOWN_F16=1 STRATA_B6_F16=1 STRATA_ROUTE_TAIL_SKIP=0"
STEPS="sustain easy"
