# Arm 3: Gyro-S in the serving layout (compose.yaml): three cards, explicit layer split, 256K context.
# The only difference from serving is the model, and resident-experts is left out: Gyro-S's weights are 29.7 GB,
# so they should all sit on the cards and low-RAM mode has nothing to do.
ARM=3card
GPUS=0,1,2
CONTEXT=256k
STRATA_SET="kv-resident=32768 layer-split=12,34 conversation-cache-mib=8192 trim-stage-weights STRATA_GU_F16=2 STRATA_SM60_D20_SUB=1 STRATA_DOWN_F16=1 STRATA_B6_F16=1 STRATA_ROUTE_TAIL_SKIP=0"
