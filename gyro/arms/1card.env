# Arm 1: Gyro-S on one card, the video's headline run (58.6 / 64.9 tok/s there, 28 GB of RAM in use).
# GPU 0: the coolest card (GPU 1 was heat-soaked at 75 C idle after the two-card arm) and the one a second
# agent would get in a two-plus-one layout. It sits on the chipset's PCIe 2.0 x4 slot. 32K context as in the video.
ARM=1card
GPUS=0
CONTEXT=32k
STRATA_SET="STRATA_GU_F16=2 STRATA_SM60_D20_SUB=1 STRATA_DOWN_F16=1 STRATA_B6_F16=1 STRATA_ROUTE_TAIL_SKIP=0"
