# llama-server from PrismML's llama.cpp fork (github.com/PrismML-Eng/llama.cpp), which has the PQ2_0 and PTQ1_0
# kernels that Ternary Bonsai 2 needs. CUDA 12.9 (CUDA 13 dropped Pascal), sm_60 only, for the Tesla P100.
# Commit c96baf4 (25 Oct 2026) is the one Kindi 0.4.0's P100 comparison used (its docs/BENCHMARKS.md).
#   docker build -t local/llama-prism:c96baf4 -f bonsai/Dockerfile.prism bonsai
ARG CUDA_VERSION=12.9.1

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04 AS build
ARG FORK_SHA=c96baf4abe24
ARG JOBS=8
RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake build-essential ca-certificates libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --filter=blob:none --no-checkout https://github.com/PrismML-Eng/llama.cpp /src \
    && git -C /src checkout ${FORK_SHA}
WORKDIR /src
RUN cmake -B build \
        -DGGML_CUDA=ON \
        -DCMAKE_CUDA_ARCHITECTURES=60 \
        -DGGML_NATIVE=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLAMA_BUILD_TESTS=OFF \
        -DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined \
    && cmake --build build --target llama-server llama-bench -j${JOBS}

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 libssl3 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/build/bin/ /app/
ENV LD_LIBRARY_PATH=/app
ENTRYPOINT ["/app/llama-server"]
