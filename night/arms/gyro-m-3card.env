# Gyro-M in the serving layout: three cards, explicit layer split, 256K. Same settings as the Gyro-S 3card arm.
# Strata's catalog gives it 35 GB of weights, so it should sit entirely in the 48 GB of VRAM.
ARM=gyro-m-3card
FAMILY=gyro
MODEL=Gyro-M
GPUS=0,1,2
CONTEXT=256k
STRATA_SET="kv-resident=32768 layer-split=12,34 conversation-cache-mib=8192 trim-stage-weights STRATA_GU_F16=2 STRATA_SM60_D20_SUB=1 STRATA_DOWN_F16=1 STRATA_B6_F16=1 STRATA_ROUTE_TAIL_SKIP=0"
