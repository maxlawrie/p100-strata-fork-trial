# Flash-Next IQ3_XXS on the two PCIe 3.0 x8 cards in peer mode, with the settings of the IQ3_S peer run
# (README, "Two-card peer mode") and 64K context as in the Gyro-S 2card-peer arm.
ARM=iq3xxs-2card-peer
FAMILY=qwen
MODEL=IQ3_XXS
GPUS=1,2
CONTEXT=64k
STRATA_SET="resident-experts kv-resident=32768 conversation-cache-mib=8192 peer-device=1 peer-reserve-mib=2000 STRATA_GU_F16=2 STRATA_SM60_D20_SUB=1 STRATA_DOWN_F16=1 STRATA_B6_F16=1 STRATA_ROUTE_TAIL_SKIP=0"
