# Gyro-S alone on GPU 1, the best-cooled card with the stronger desk fan. Video: 58.6 / 64.9 tok/s on one P100.
ARM=gyro-s-1card-gpu1
FAMILY=gyro
MODEL=Gyro-S
GPUS=1
CONTEXT=32k
STRATA_SET="STRATA_GU_F16=2 STRATA_SM60_D20_SUB=1 STRATA_DOWN_F16=1 STRATA_B6_F16=1 STRATA_ROUTE_TAIL_SKIP=0"
STEPS="easy sustain"
