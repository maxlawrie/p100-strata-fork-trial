# Serving model and settings (compose.yaml) plus prefill-pipe=768: prompt chunks sized so the stages read at once (NYCU-WinLab: +9-11% reading up to 4K, nothing at 16K; it changes answers).
# Speed runs only: the question is tok/s against tune-base, run in the same session.
ARM=tune-prefillpipe
FAMILY=qwen
MODEL=IQ3_S
GPUS=0,1,2
CONTEXT=256k
STRATA_SET="resident-experts kv-resident=32768 layer-split=12,34 conversation-cache-mib=8192 trim-stage-weights STRATA_GU_F16=2 STRATA_SM60_D20_SUB=1 STRATA_DOWN_F16=1 STRATA_B6_F16=1 STRATA_ROUTE_TAIL_SKIP=0 prefill-pipe=768"
STEPS="easy hard"
