# Flash-Next Coder IQ1_M on the same two cards in peer mode. Its 23.4 GB of experts should all fit in VRAM, so
# resident-experts is left out, as for Gyro-S.
ARM=coder-2card-peer
FAMILY=coder
MODEL=IQ1_M
GPUS=1,2
CONTEXT=64k
STRATA_SET="kv-resident=32768 conversation-cache-mib=8192 peer-device=1 peer-reserve-mib=2000 STRATA_GU_F16=2 STRATA_SM60_D20_SUB=1 STRATA_DOWN_F16=1 STRATA_B6_F16=1 STRATA_ROUTE_TAIL_SKIP=0"
