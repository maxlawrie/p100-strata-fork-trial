# Serving model and settings (compose.yaml) plus the sm_60 switches NYCU-WinLab/strata-p100-deployment measured at +5.7% one-user decode on Strata 0.1.45.
# Speed runs only: the question is tok/s against tune-base, run in the same session.
ARM=tune-p6
FAMILY=qwen
MODEL=IQ3_S
GPUS=0,1,2
CONTEXT=256k
STRATA_SET="resident-experts kv-resident=32768 layer-split=12,34 conversation-cache-mib=8192 trim-stage-weights STRATA_GU_F16=2 STRATA_SM60_D20_SUB=1 STRATA_DOWN_F16=1 STRATA_B6_F16=1 STRATA_ROUTE_TAIL_SKIP=0 STRATA_SIDE_MIXER=2 STRATA_FUSE_WAIT=2 STRATA_B6_MMVQ_ROWS=1 STRATA_GR_UP75=1 STRATA_ADAPT_NOWAIT=1 STRATA_ADAPT_LAG=2"
STEPS="easy hard"
