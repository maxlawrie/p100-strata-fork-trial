+constexpr int ff_lo(int n, int c) {
+    return n == 3 ? (c == 0 ? 0 : c == 1 ? 256 : c == 2 ? 512 : FF) : FFU * (c * (FF / FFU / n) + (c < FF / FFU % n ? c : FF / FFU % n));
+}
